# ---------------------------------------------------------------------------
# StackAmit-IDE — Frontend environment example
# Copy to `client/.env`. Only VITE_-prefixed vars reach the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the backend API.
#   Development: leave empty to use the Vite dev-server proxy ("/api" -> :5000).
#   Production:  set to the deployed API origin, e.g. https://api.stackamit.example
# Never put execution-provider secrets here — the browser must only ever talk
# to our own API.
VITE_API_URL=

# Optional brand text shown in the footer attribution.
VITE_FOOTER_ATTRIBUTION=Built by StackAmit
