{
  "name": "stackamit-ide-client",
  "version": "1.2.10",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.cjs",
  "author": "StackAmit",
  "description": "StackAmit-IDE frontend — Online & Ofline code editor and compiler UI.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stage-installer.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "gen:icon": "node scripts/gen-icon.mjs",
    "stage:installer": "node scripts/stage-installer.mjs",
    "dev:electron": "node scripts/dev-electron.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist:win": "cross-env STACKAMIT_ELECTRON_BUILD=1 npm run build && npm run gen:icon && npm run typecheck:electron && cross-env STACKAMIT_REQUIRE_API_ORIGIN=1 npm run build:electron && electron-builder --win && npm run stage:installer"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.7.7",
    "lucide-react": "^0.451.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.11",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.47",
    "pyright": "^1.1.414",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.4",
    "vscode-ws-jsonrpc": "^3.5.0",
    "wait-on": "^8.0.1",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "electron@33.2.0": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "@electron/rebuild@3.6.0": true
  },
  "build": {
    "appId": "net.stackamit.ide",
    "productName": "StackAmit-IDE",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**",
      "electron/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "StackAmit-IDE"
    }
  }
}
