    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "ws": "^8.20.1",
    "zod": "^4.6.7"
