# ---------------------------------------------------------------------------
# StackAmit-IDE — Backend environment example
# Copy this file to `server/.env` and adjust values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Explicit allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (optional).
# The editor and execution work even when this is empty or unreachable.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Code execution provider
# ---------------------------------------------------------------------------
# Choose which real execution engine the backend talks to server-to-server:
#   piston   -> a Piston-compatible API (self-hosted or whitelisted instance)
#   wandbox  -> the public Wandbox service (works out of the box, rate limited)
EXECUTION_PROVIDER=wandbox

# Piston-compatible API base URL. The official public instance is now
# whitelist-only, so point this at your own self-hosted Piston or a
# whitelisted deployment. Example base (append path is configurable):
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_RUN_PATH=/execute
PISTON_RUNTIMES_PATH=/runtimes

# Wandbox endpoints (used when EXECUTION_PROVIDER=wandbox)
WANDBOX_API_URL=https://wandbox.org/api
WANDBOX_COMPILE_PATH=/compile.json
WANDBOX_LIST_PATH=/list.json

# Optional server-only API key for providers that require authentication.
# Never place this in any VITE_* variable or expose it to the browser.
EXECUTION_API_KEY=
# Header name used to send the key, if required (empty = Authorization: Bearer)
EXECUTION_API_KEY_HEADER=

# Outbound request timeout to the provider (ms). Compiled languages (Go,
# Rust, C#, Julia, Haskell) on a cold free-tier container measured 24-41s
# during Oct 2026 verification, so keep this well above a minute.
EXECUTION_TIMEOUT_MS=90000

# ---------------------------------------------------------------------------
# Application-side limits (enforced by our API, not a guarantee of
# provider-side enforcement)
# ---------------------------------------------------------------------------
MAX_SOURCE_BYTES=65536
MAX_STDIN_BYTES=16384
MAX_OUTPUT_BYTES=65536

EXECUTION_RATE_LIMIT_WINDOW_MS=60000
EXECUTION_RATE_LIMIT_MAX=10
MAX_CONCURRENT_EXECUTIONS=3

# Snippet sharing (optional persistence feature)
SNIPPET_ENABLED=true
SNIPPET_DEFAULT_TTL_DAYS=30
SNIPPET_MAX_CODE_BYTES=65536

# ---------------------------------------------------------------------------
# Admin authentication (manages the application from /login + /admin)
# ---------------------------------------------------------------------------
# There is NO public register/login UI. Only this single admin account exists.
# The admin reaches the login form directly via the /login route.
# ADMIN_PASSWORD is stored here in plaintext for simplicity; keep .env secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-secret
# Secret used to sign admin session tokens (JWT). Use a long random string.
# If empty in development an ephemeral secret is generated (sessions end on
# restart). REQUIRED in production.
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_HOURS=12

# ---------------------------------------------------------------------------
# End-user authentication (separate from admin authentication)
# ---------------------------------------------------------------------------
# Required to enable registration/login. Use a different high-entropy secret
# from ADMIN_JWT_SECRET. MongoDB is required for user accounts and revocation.
USER_JWT_SECRET=
USER_TOKEN_TTL_DAYS=30
USER_BCRYPT_ROUNDS=12
# 32-byte base64 or 64-character hex key. Generate with a secret manager.
AI_CREDENTIAL_ENCRYPTION_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=StackAmit IDE
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Logging
LOG_LEVEL=info
